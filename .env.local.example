# ─────────────────────────────────────────────────────────────
# Sarawak Trip Planner — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
#
#   NEXT_PUBLIC_*  -> exposed to the browser. Only non-secret values.
#   everything else -> server-only. Never import into client components.
# ─────────────────────────────────────────────────────────────

# ── App (Phase 1) ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo mode: whole app on fixture data, fake session, nothing persisted.
# Auto-ON when Supabase is unconfigured; set "false" to force real mode.
NEXT_PUBLIC_DEMO_MODE=true

# ── Supabase (Phase 2) ───────────────────────────────────────
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used only in trusted server code (webhooks, admin, seeding).
SUPABASE_SERVICE_ROLE_KEY=
# For local `supabase` CLI / migrations (Project settings -> Database -> Connection string)
SUPABASE_DB_URL=

# ── AI — Anthropic (Phase 4) ─────────────────────────────────
ANTHROPIC_API_KEY=
# Optional overrides
AI_PLANNER_MODEL=claude-sonnet-5
AI_REFINE_MODEL=claude-haiku-4-5

# ── Maps — Mapbox (Phase 3) ──────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Rate limiting — Upstash Redis (Phase 4/9) ────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email — Resend (Phase 7) ─────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Sarawak Trip Planner <bookings@example.com>"

# ── Payments (Phase 7) ───────────────────────────────────────
# mock | stripe | billplz
PAYMENT_PROVIDER=mock
# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Billplz (sandbox)
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=

# ── Error monitoring — Sentry (Phase 9, optional) ────────────
NEXT_PUBLIC_SENTRY_DSN=
